# Generated local demo credentials: node tools/demo/init.mjs
# For manual configuration, set all blank secrets to unique random values.
# .NET does not load this file automatically: use tools/demo/run.mjs or export variables.
ASPNETCORE_ENVIRONMENT=Development
DatabaseProvider=Sqlite
Edge__DatabasePath=data/demo.db
Demo__Enabled=false
JWT_SECRET_KEY=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional authenticated standalone Edge status/config channel; match on API and Edge.
Edge__ApiKey=
# Required only for TimescaleDb; full Npgsql connection string.
ConnectionStrings__TimescaleDb=
VITE_DEMO_MODE=false
